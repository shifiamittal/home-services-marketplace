{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nivasa-home-help",
  "account_id": "0c53a1d6277d240fe99359ce0495fe9d",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Deliberately enable public access only after migrations, secrets, and
  // provider-domain restrictions are complete.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivasa-production",
      "database_id": "508b580c-9da0-41ad-97d2-4695047eb2b0",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nivasa-private-address-proofs"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
