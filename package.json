{
  "name": "nivasa-home-help",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:production": "bash scripts/cloudflare-production.sh build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern '.wrangler/**'",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "cloudflare:types": "bash scripts/cloudflare-production.sh types",
    "cloudflare:validate": "bash scripts/cloudflare-production.sh validate",
    "cloudflare:deploy:dry-run": "bash scripts/cloudflare-production.sh dry-run",
    "cloudflare:d1:migrations:list": "bash scripts/cloudflare-production.sh migrations-list",
    "cloudflare:d1:migrations:apply": "bash scripts/cloudflare-production.sh migrations-apply",
    "cloudflare:deploy": "bash scripts/cloudflare-production.sh deploy"
  },
  "dependencies": {
    "@pushforge/builder": "2.0.5",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Nivasa Home Help Marketplace"
}
